      "html": "<a class=\"ds-public-card\" href=\"/algorithms/\"><span class=\"ds-public-sticker\"><svg viewBox=\"0 0 32 32\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"8\" height=\"8\" rx=\"2\"/><rect x=\"21\" y=\"21\" width=\"8\" height=\"8\" rx=\"2\"/><path d=\"M11 7h10a4 4 0 0 1 4 4v10M7 11v10a4 4 0 0 0 4 4h10M17 3l4 4-4 4M3 17l4 4 4-4\"/></svg></span><h3>算法</h3></a>",
      "css": ".ds-public-card{display:flex;flex-direction:column;min-height:254px;padding:24px;border:1px solid var(--vp-c-divider,rgba(223,230,241,.14));border-radius:var(--blog-radius,16px);color:var(--vp-c-text-1,#f6f4ef);background:var(--blog-panel,#1c2330);text-decoration:none;font-family:var(--vp-font-family-base,Manrope,\"Noto Sans SC\",sans-serif);transition:border-color .2s var(--blog-ease,cubic-bezier(.16,1,.3,1)),background .2s var(--blog-ease,cubic-bezier(.16,1,.3,1))}.ds-public-card:hover{border-color:var(--blog-accent,#86a8ff);background:#232d3d}.ds-public-card:focus-visible{outline:3px solid #a8bfff;outline-offset:5px}.ds-public-card:active{background:#2b3649}.ds-public-card h3{margin:20px 0 10px;font-size:1.75rem;font-weight:700;letter-spacing:-.02em}.ds-public-sticker{display:grid;place-items:center;width:48px;height:44px;border:3px solid #eef0f4;border-radius:13px;color:var(--blog-ink,#111827);background:var(--blog-accent,#86a8ff);transform:rotate(-7deg);transition:transform .2s var(--blog-ease,cubic-bezier(.16,1,.3,1))}.ds-public-sticker svg{width:26px;height:26px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-public-card:hover .ds-public-sticker{transform:rotate(0)}@media(max-width:760px){.ds-public-card{min-height:224px;padding:20px}.ds-public-card h3{font-size:1.5rem}}@media(prefers-reduced-motion:reduce){.ds-public-card,.ds-public-sticker{transition:none}}"
