      "html": "<a class=\"ds-public-primary\" href=\"#knowledge-topics\">浏览六个栏目 <svg viewBox=\"0 0 32 32\" aria-hidden=\"true\"><path d=\"M6 16h20m-7-7 7 7-7 7\"/></svg></a>",
      "css": ".ds-public-primary{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:52px;padding:0 20px;border-radius:12px;font:700 15px var(--vp-font-family-base,Manrope,\"Noto Sans SC\",sans-serif);color:var(--blog-ink,#111827);background:var(--blog-accent,#86a8ff);text-decoration:none;transition:background .2s var(--blog-ease,cubic-bezier(.16,1,.3,1)),transform .2s var(--blog-ease,cubic-bezier(.16,1,.3,1))}.ds-public-primary svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-public-primary:hover{background:#a3bcff}.ds-public-primary:focus-visible{outline:3px solid #a8bfff;outline-offset:5px}.ds-public-primary:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-public-primary{transition:none}}"
    },
