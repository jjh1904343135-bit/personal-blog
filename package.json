{
  "name": "internet-field-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "admin": "node scripts/author-server.js",
    "write": "node scripts/author-server.js",
    "editor:build": "node scripts/build-editor.js",
    "remote:build": "node scripts/build-remote-write.js",
    "preadmin": "npm run editor:build",
    "prewrite": "npm run editor:build",
    "sync": "node scripts/sync-content.js",
    "sync:watch": "node scripts/sync-content.js --watch",
    "test": "node --test --test-concurrency=1 scripts/*.test.js",
    "gen-img": "node scripts/generate-image.js"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.5",
    "@netlify/database": "^2.0.1",
    "@netlify/functions": "^6.0.3",
    "@netlify/identity": "^2.0.0",
    "dotenv": "^16.4.7",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "markdown-it": "^15.0.2",
    "vitepress": "^1.6.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@netlify/database-dev": "^1.0.1",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-code-block-lowlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/markdown": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "decap-server": "^3.3.1",
    "lowlight": "^3.3.0",
    "vite": "^6.4.4",
    "vite-plugin-compression2": "^1.3.3"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.4"
    },
    "decap-server": {
      "simple-git": "4.0.2"
    }
  },
  "engines": {
    "node": ">=22.12"
  }
}
